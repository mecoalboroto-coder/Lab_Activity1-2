<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:conv="using:EquipmentBorrowing.Desktop.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingSearchView"
             x:DataType="vm:BorrowingSearchViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0" Text="Search Borrowings" Classes="SectionTitle" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     Watermark="Student name, student number or equipment name" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,Auto" Margin="0,8,0,0">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedIndex="{Binding StatusIndex}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SortOptions}"
                      SelectedIndex="{Binding SortIndex}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,8,0" />
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding DirectionOptions}"
                      SelectedIndex="{Binding DirectionIndex}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Loading..." IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding ResultSummary}"
                       IsVisible="{Binding ResultSummary, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
            <TextBlock Text="{Binding EmptyMessage}"
                       IsVisible="{Binding EmptyMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToStatusBrushConverter.Instance}}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="4" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:HistoryRow">
                    <Border Classes="EquipmentCard">
                        <StackPanel>
                            <TextBlock Text="{Binding EquipmentName}" Classes="ItemTitle" />
                            <TextBlock Text="{Binding StudentName}" Classes="ItemSubtitle" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DateBorrowed, StringFormat='Checked out: {0:d}'}" Classes="ItemMeta" />
                                <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:d}'}" Classes="ItemMeta" />
                                <TextBlock Text="{Binding ReturnedText}" Classes="ItemMeta" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Classes="ItemMeta" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>

</UserControl>
