<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:models="using:EquipmentBorrowing.Domain"
             xmlns:conv="using:EquipmentBorrowing.Desktop.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentHistoryView"
             x:DataType="vm:StudentHistoryViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0" Text="Student Borrowing History" Classes="SectionTitle" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Select a student">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:Student">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Loading history..." IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding EmptyMessage}"
                       IsVisible="{Binding EmptyMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToStatusBrushConverter.Instance}}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="3" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:HistoryRow">
                    <Border Classes="EquipmentCard">
                        <StackPanel>
                            <TextBlock Text="{Binding EquipmentName}" Classes="ItemTitle" />
                            <TextBlock Text="{Binding EquipmentIdentifier, StringFormat='Item: {0}'}" Classes="ItemSubtitle" />
                            <TextBlock Text="{Binding StudentName}" Classes="ItemSubtitle" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DateBorrowed, StringFormat='Checked out: {0:d}'}" Classes="ItemMeta" />
                                <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:d}'}" Classes="ItemMeta" />
                                <TextBlock Text="{Binding ReturnedText}" Classes="ItemMeta" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Classes="ItemMeta" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>

</UserControl>
