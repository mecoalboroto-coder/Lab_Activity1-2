<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:conv="using:EquipmentBorrowing.Desktop.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Active Borrowings" Classes="SectionTitle" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ActiveBorrowings}"
                 SelectedItem="{Binding SelectedBorrowing}"
                 Margin="0,8,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:BorrowingDisplayItem">
                    <Border Classes="EquipmentCard">
                        <StackPanel>
                            <TextBlock Text="{Binding EquipmentName}" Classes="ItemTitle" />
                            <TextBlock Text="{Binding StudentName, StringFormat='Borrowed by: {0}'}" Classes="ItemSubtitle" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DateBorrowed, StringFormat='Borrowed: {0:d}'}" Classes="ItemMeta" />
                                <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:d}'}" Classes="ItemMeta" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="8">
            <Button Content="Return Equipment"
                    Command="{Binding ReturnCommand}"
                    Classes="PrimaryButton"
                    HorizontalAlignment="Left" />

            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToStatusBrushConverter.Instance}}"
                       TextWrapping="Wrap" />
        </StackPanel>

    </Grid>

</UserControl>
