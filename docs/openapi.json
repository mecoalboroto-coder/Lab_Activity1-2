    "/api/v1/borrowings": {
      "get": {
        "tags": [
          "Borrowings"
        ],
        "summary": "Search, filter and sort borrowings. Defaults: status=All, sort=borrowedDate, direction=asc.",
        "operationId": "ListBorrowings",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "enum": [
                "Active",
                "Returned",
                "All"
              ],
              "type": "string",
              "default": "All"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "enum": [
                "borrowedDate",
                "expectedReturnDate"
              ],
              "type": "string",
              "default": "borrowedDate"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BorrowingDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
